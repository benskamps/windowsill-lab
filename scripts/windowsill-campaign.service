# Windowsill "run constantly" — systemd USER service.
# Install:  cp to ~/.config/systemd/user/ ; systemctl --user daemon-reload ;
#           systemctl --user enable --now windowsill-campaign.service
# Stop:     touch ~/.lab/campaign.stop   (graceful, after current pass)
#           systemctl --user stop windowsill-campaign.service   (hard)
# It supersedes the nightly timer — disable that when this is on:
#           systemctl --user disable --now windowsill-lab.timer
# Cadence (2026-08-01): 4 passes/day anchored to 03/09/15/21 LOCAL, interleaved
# with the Windows box's 00/06/12/18 local Task Scheduler slots — 8 portfolio
# turns/day. INTERVAL=21600 (6h) is the fallback when HOURS is unset; with
# HOURS set, campaign.sh sleeps to the next listed hour boundary (drift-free).
# Re-arming after merge is a human step — this file is a template, nothing here
# enables or restarts the unit.
[Unit]
Description=Windowsill Lab — continuous physics campaign (run constantly)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=TMPDIR=%h/.cache/wtmp
Environment=LAB_CAMPAIGN_DEVICE=cuda
Environment=LAB_CAMPAIGN_INTERVAL=21600
Environment="LAB_CAMPAIGN_HOURS=3 9 15 21"
# This box also runs windowsill-hunt.timer, which hunts loam's sectors every
# slot on a 100-minute budget. Without this line the campaign ALSO picked A05
# four times a day and ran it on the scheduler's 45-minute default — which,
# after the 2026-08-20 search level-ups, no longer finished a slice: passes
# 134-137 each burnt ~45 minutes, wrote no receipt, published nothing, and
# starved the physics ladder, all at exit 0. Declaring the lane is the fix;
# two lanes hunting the same sectors was duplicated work even when it worked.
# A box with no dedicated hunt lane must NOT set this, or it stops hunting.
Environment=LAB_NEXT_SKIP=A05
# %h is expanded by systemd to the invoking user's home directory. The unit
# calls itself a template; a hardcoded /home/<name> path made it neither a
# template nor private.
ExecStart=%h/projects/windowsill-lab/scripts/campaign.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
